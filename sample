<!-- JavaScript -->
<script>
  // ダークモード切替
  function toggleDarkMode() {
    const html = document.documentElement;
    const icon = document.getElementById('dark-mode-icon');
    
    if (html.classList.contains('dark')) {
      html.classList.remove('dark');
      icon.setAttribute('data-lucide', 'moon');
    } else {
      html.classList.add('dark');
      icon.setAttribute('data-lucide', 'sun');
    }
    lucide.createIcons();
  }

  // モバイルメニュー切替
  function toggleMobileMenu() {
    const menu = document.getElementById('mobile-menu');
    menu.classList.toggle('hidden');
  }

  // モーダル操作
  function openModal() {
    document.getElementById('info-modal').classList.remove('hidden');
  }
  function closeModal() {
    document.getElementById('info-modal').classList.add('hidden');
  }

  // ロゴクリックアクション
  let clickCount = 0;
  function handleLogoClick() {
    clickCount++;
    if (clickCount === 5) {
      alert('隠しコマンドが解除されました！');
      clickCount = 0;
    }
  }

  // エンタメおみくじ
  function runOmikuji() {
    const results = ['M6ボルト（大吉）', 'M4ナット（吉）', 'ワッシャー（中吉）', 'スプリング（小吉）'];
    const random = results[Math.floor(Math.random() * results.length)];
    const elem = document.getElementById('omikuji-result');
    elem.textContent = `結果: ${random}`;
    elem.classList.remove('hidden');
  }

  // フロアマップデータ
  const floors = [
    {
      id: '1f',
      name: '1階：精密加工・製造フロア',
      image: 'https://placehold.co/800x500/e2e8f0/475569?text=1F+Floor+Map',
      items: [
        { icon: 'cpu', text: 'マシニングセンタエリア' },
        { icon: 'settings', text: 'NC旋盤加工ゾーン' },
        { icon: 'truck', text: '搬入口・資材保管庫' }
      ]
    },
    {
      id: '2f',
      name: '2階：設計・開発・オフィス',
      image: 'https://placehold.co/800x500/e2e8f0/475569?text=2F+Floor+Map',
      items: [
        { icon: 'monitor', text: '3D CAD/CAM 設計室' },
        { icon: 'users', text: '商談・打ち合わせスペース' },
        { icon: 'coffee', text: '社員リフレッシュルーム' }
      ]
    },
    {
      id: '3f',
      name: '3階：検査・品質管理・ラボ',
      image: 'https://placehold.co/800x500/e2e8f0/475569?text=3F+Floor+Map',
      items: [
        { icon: 'check-circle', text: '三次元測定室' },
        { icon: 'flask-conical', text: '研究開発ラボ' },
        { icon: 'shield-check', text: '品質保証課 Office' }
      ]
    }
  ];

  let currentFloorIndex = 0;

  function renderTabs() {
    const tabsContainer = document.getElementById('floor-tabs');
    tabsContainer.innerHTML = '';

    floors.forEach((floor, index) => {
      const btn = document.createElement('button');
      btn.className = `px-4 py-2 rounded-xl font-medium text-sm transition-colors ${
        index === currentFloorIndex
          ? 'bg-sky-500 text-white shadow-sm'
          : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700'
      }`;
      btn.textContent = floor.name.split('：')[0];
      btn.onclick = () => switchFloor(index);
      tabsContainer.appendChild(btn);
    });
  }

  function switchFloor(index) {
    currentFloorIndex = index;
    const floor = floors[index];

    const img = document.getElementById('floor-image');
    img.style.opacity = '0';
    setTimeout(() => {
      img.src = floor.image;
      img.style.opacity = '1';
    }, 150);

    document.getElementById('floor-name').textContent = floor.name;

    const list = document.getElementById('floor-list');
    list.innerHTML = '';
    floor.items.forEach(item => {
      const li = document.createElement('li');
      li.className = 'flex items-center space-x-3 p-2 rounded-lg bg-white dark:bg-slate-800 shadow-sm border border-slate-100 dark:border-slate-700/50';
      li.innerHTML = `
        <i data-lucide="${item.icon}" class="w-5 h-5 text-sky-500 flex-shrink-0"></i>
        <span>${item.text}</span>
      `;
      list.appendChild(li);
    });

    renderTabs();
    lucide.createIcons();
  }

  // 初期化ロード
  window.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
    switchFloor(0);
  });
</script>
</body>
</html>
